'use strict';
const fs = require('node:fs/promises');
const path = require('node:path');
const SOURCE = 'https://smok95.github.io/lotto/results/all.json';
function validate(draws) {
  if (!Array.isArray(draws) || !draws.length) throw Error('빈 회차 데이터');
  const sorted = draws.slice().sort((a,b)=>a.drawNo-b.drawNo);
  sorted.forEach((d,i)=>{
    if (d.drawNo !== i+1) throw Error('1회부터 연속된 전체 회차가 필요합니다');
    if (!Array.isArray(d.numbers) || d.numbers.length!==6 || new Set(d.numbers).size!==6 || ![...d.numbers,d.bonus].every(n=>Number.isInteger(n)&&n>=1&&n<=45) || d.numbers.includes(d.bonus)) throw Error(`번호 오류: ${d.drawNo}회`);
    if (typeof d.date!=='string' || !Number.isFinite(Date.parse(d.date))) throw Error('날짜 오류');
  });
  return sorted.reverse();
}
function convert(rows) {
  if (!Array.isArray(rows)) throw Error('원본 형식 오류');
  return validate(rows.map(d=>({drawNo:d.draw_no,date:d.date,numbers:Array.isArray(d.numbers)?d.numbers.slice().sort((a,b)=>a-b):d.numbers,bonus:d.bonus_no})));
}
async function update({fetcher=fetch, output=path.join(__dirname,'lotto-history.json'), now=()=>new Date().toISOString()}={}) {
  let rows, lastError;
  for(let i=0;i<3;i++) {
    try { const res=await fetcher(SOURCE,{signal:AbortSignal.timeout(30000)}); if(!res.ok) throw Error(`HTTP ${res.status}`); rows=await res.json(); break; }
    catch(e) { lastError=e; if(i<2) await new Promise(r=>setTimeout(r,1000*(i+1))); }
  }
  if (!rows) throw lastError;
  const draws=convert(rows);
  let old;
  try { old=JSON.parse(await fs.readFile(output,'utf8')); validate(old.draws); } catch(e) { if(e.code!=='ENOENT') throw e; }
  if(old && draws[0].drawNo<old.draws[0].drawNo) throw Error('원본 회차가 후퇴하여 기존 파일을 보존합니다');
  if(old && JSON.stringify(old.draws)===JSON.stringify(draws)) return false;
  const payload={schemaVersion:1,source:SOURCE,updatedAt:now(),count:draws.length,latestDrawNo:draws[0].drawNo,draws};
  const tmp=output+'.tmp';
  try { await fs.writeFile(tmp,JSON.stringify(payload,null,2)+'\n'); await fs.rename(tmp,output); } finally { await fs.rm(tmp,{force:true}); }
  return true;
}
module.exports={validate,convert,update};
if(require.main===module) update().then(changed=>console.log(changed?'당첨번호 업데이트 완료':'변경 없음')).catch(e=>{console.error(e.message);process.exitCode=1;});
