async function loadLottoHistory() {
  const sources = [
    {
      url: 'https://smok95.github.io/lotto/results/all.json',
      convert(data) {
        if (!Array.isArray(data)) {
          throw new Error('전체 회차 응답 형식이 올바르지 않습니다.');
        }

        return {
          draws: data.map(row => ({
            drawNo: Number(row.draw_no),
            date: row.date,
            numbers: Array.isArray(row.numbers)
              ? row.numbers.map(Number).sort((a, b) => a - b)
              : [],
            bonus: Number(row.bonus_no)
          })),
          updatedAt: new Date().toISOString()
        };
      }
    },
    {
      url: './lotto-history.json',
      convert(data) {
        return data;
      }
    }
  ];

  for (const source of sources) {
    try {
      const response = await fetch(source.url, {
        cache: 'no-store',
        signal: AbortSignal.timeout(15000)
      });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const data = source.convert(await response.json());

      return {
        ...data,
        draws: validateDraws(data.draws)
      };
    } catch (error) {
      console.warn('당첨번호 불러오기 실패:', source.url, error);
    }
  }

  throw new Error(
    '전체 당첨번호를 불러오지 못했습니다. 잠시 후 다시 시도해주세요.'
  );
}
